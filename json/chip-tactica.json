{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/column-formatting.schema.json",
  "elmType": "div",
  "style": {
    "display": "inline-flex",
    "align-items": "center",
    "gap": "6px",
    "padding": "2px 10px",
    "border-radius": "999px",
    "font-size": "12px",
    "font-weight": "600",
    "white-space": "nowrap",
    "background-color": "#F1E9FA",
    "color": "#5C2D91"
  },
  "children": [
    {
      "elmType": "span",
      "style": {
        "font-size": "12px"
      },
      "attributes": {
        "iconName": "Shield"
      }
    },
    {
      "elmType": "span",
      "txtContent": "@currentField"
    }
  ]
}